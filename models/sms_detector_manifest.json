{
  "model_name": "ThreatGuard SMS Scam Detector",
  "version": "v1",
  "status": "production_candidate",
  "model_type": "word + character TF-IDF + Logistic Regression",
  "label_convention": {
    "0": "legitimate",
    "1": "scam"
  },
  "training_dataset": {
    "name": "sidzzz07/scamshield-dataset",
    "cleaning": [
      "official train/validation/test splits preserved",
      "empty messages removed",
      "exact duplicate texts removed within each split"
    ],
    "train_samples": 69237,
    "validation_samples": 8191,
    "test_samples": 8201
  },
  "word_tfidf": {
    "analyzer": "word",
    "ngram_range": [1, 2],
    "max_features": 120000,
    "min_df": 2,
    "max_df": 0.995,
    "sublinear_tf": true,
    "strip_accents": "unicode",
    "lowercase": true
  },
  "character_tfidf": {
    "analyzer": "char",
    "ngram_range": [3, 5],
    "max_features": 120000,
    "min_df": 2,
    "sublinear_tf": true,
    "lowercase": true
  },
  "classifier": {
    "type": "LogisticRegression",
    "C": 4.0,
    "class_weight": "balanced",
    "solver": "liblinear",
    "max_iter": 1000,
    "random_state": 42
  },
  "threshold": 0.5,
  "validation": {
    "accuracy": 0.981321,
    "precision": 0.971561,
    "recall": 0.977704,
    "f1": 0.974623,
    "roc_auc": 0.997470,
    "pr_auc": 0.996154
  },
  "test": {
    "accuracy": 0.978295,
    "precision": 0.968884,
    "recall": 0.972102,
    "f1": 0.970491,
    "roc_auc": 0.996449,
    "pr_auc": 0.994378,
    "false_positives": 94,
    "false_negatives": 84
  },
  "language_evaluation": {
    "English": {
      "samples": 7633,
