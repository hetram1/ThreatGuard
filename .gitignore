.idea/

# Preserve datasets locally; publish their provenance and split metadata.
data/raw/*
!data/raw/.gitkeep
data/processed/**/*.csv
data/processed/**/*.parquet
data/reliable/
data/external/**/*.csv

# Generated model checkpoints remain local except the two small verified bundles.
models/**/*.joblib
models/**/*.pkl
models/**/*.pickle
!models/releases/reliable-v1/url.joblib
!models/releases/reliable-v1/sms.joblib
models/audit/*.csv
models/releases/**/*.csv
!models/releases/reliable-v1/audit_regressions.csv
models/releases/reproducibility-*/

# Detailed regenerable predictions and machine-specific runtime snapshots.
audit/*_holdout_predictions.csv
audit/cleanup_behavior_before.json
audit/cleanup_behavior_after.json
audit/history_before_repair_verification.json
audit/tmp/
