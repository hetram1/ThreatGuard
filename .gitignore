# Local data, environments and runtime outputs
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
node_modules/
frontend/dist/
frontend/dist-ssr/
.vite/
.cache/
*.log
*.sqlite
*.sqlite3
*.db
*.db-journal
*.pid
.env
.env.*
!.env.example
*.local
.ipynb_checkpoints/
.DS_Store
Thumbs.db
